# Kopieer dit bestand naar ".env" en vul je eigen Supabase-gegevens in.
# Te vinden in Supabase: Project Settings -> API.
# De publishable/anon key mag openbaar zijn (beveiligd met Row Level Security).
VITE_SUPABASE_URL=https://JOUW-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
